# Ignore patterns for the dotfiles repo

# ── legacy / staged content under review (do not commit until reviewed) ──
scripts/legacy/

# ── runtime data (the *.db files live in /home/shared/data/ via symlink) ──
data/**/*.db
data/**/*.db-shm
data/**/*.db-wal
data/**/*.db-journal

# ── backups created by the migration itself ──
Backups/
*.bak
*.backup

# ── editor / OS junk ──
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.vscode/
.idea/

# ── standard build / install artifacts (defensive) ──
node_modules/
__pycache__/
*.pyc
.cache/

# auto-generated daily reflection systemd units (per-day, generated by generate_daily.py)
config/systemd/user/daily-reflection-*.service
config/systemd/user/daily-reflection-*.timer
config/systemd/user/timers.target.wants/daily-reflection-*.timer

# auto-generated daily reflection systemd units
config/systemd/user/daily-reflection-*.service
config/systemd/user/daily-reflection-*.timer
config/systemd/user/timers.target.wants/daily-reflection-*.timer
