# API keys - sourced by ~/.zshrc
# chmod 600, gitignored (home/.gitignore)
# Copy this file to ~/.env.local and fill in your actual API keys.

# OpenRouter (https://openrouter.ai/settings/keys)
export OPENROUTER_API_KEY="<OPENROUTER_API_KEY>"

# NVIDIA NIM (https://build.nvidia.com)
export NIM_API_KEY="<NVIDIA_NIM_API_KEY>"

# Obsidian with-context MCP (safe to include these values - they are local-only tokens)
export OBSIDIAN_API_KEY="e81e61b3431a66371ff40485c797700c52f899ad37a4f128dd252caa78d7d970"
export OBSIDIAN_API_URL="https://127.0.0.1:27124"
export OBSIDIAN_VAULT="<OBSIDIAN_VAULT_PATH>"

# OpenCode free provider keys (added 2026-09-04)
# Groq (https://console.groq.com)
export GROQ_API_KEY="<GROQ_API_KEY>"

# Z.ai / Zhipu (https://z.ai/manage-apikey/apikey-list)
export ZAI_API_KEY="<ZAI_API_KEY>"

# Ollama Cloud (https://ollama.com)
export OLLAMA_API_KEY="<OLLAMA_API_KEY>"