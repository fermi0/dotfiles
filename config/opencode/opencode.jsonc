{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/AGENTS.md", "~/shared/Zurnel/Intentions.md"],
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama-server (raw llama.cpp)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "timeout": 900000,
        "chunkTimeout": 120000
      },
      "models": {
        "ornith-35b-a3b": {
          "name": "Ornith-1.5-35B-A3B APEX-Quality - agentic RL-tuned MoE, ctx 256k (KV q8_0)",
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "stream": true,
          "options": {
            "temperature": 0.6
          },
          "variants": {
            "precise": {
              "temperature": 0.2,
              "top_p": 0.9,
              "min_p": 0.05
            },
            "balanced": {
              "temperature": 0.6,
              "top_p": 0.95,
              "min_p": 0.1
            },
            "creative": {
              "temperature": 0.8,
              "top_p": 0.95
            },
            "benchmark": {
              "temperature": 1.0
            }
          }
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Open Router",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 900000,
        "chunkTimeout": 120000,
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
