{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama-server (raw llama.cpp)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "timeout": 900000,
        "chunkTimeout": 120000,
        "top_p": 0.95
      },
      "models": {
        "Ornith-1.5-35B-A3B-APEX-Quality": {
          "name": "Ornith-1.5-35B-A3B APEX - agentic RL-tuned MoE, (KV q8_0)",
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "stream": true,
          "options": {
            "temperature": 0.6
          },
          "variants": {
            "precise": {
              "temperature": 0.2,
              "top_p": 0.9,
              "min_p": 0.05
            },
            "balanced": {
              "temperature": 0.6,
              "top_p": 0.95,
              "min_p": 0.1
            },
            "creative": {
              "temperature": 0.8,
              "top_p": 0.95
            },
            "benchmark": {
              "temperature": 1.0,
              "top_p": 0.99,
              "min_p": 0.1
            }
          }
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Open Router",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 900000,
        "chunkTimeout": 120000,
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.2": {
          "name": "GLM-5.2 (Z.ai paid) - $0.97/$3.04 per 1M tok, ~$0.0001/call",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "stream": true,
          "reasoning": true,
          "options": {
            "temperature": 1.0,
            "top_p": 0.95
          },
          "variants": {
            "reasoning": {
              "reasoningEffort": "high"
            },
            "balanced": {
              "reasoningEffort": "medium"
            },
            "concise": {
              "reasoningEffort": "low"
            }
          }
        }
      }
      // Other models auto-managed by opencode-auto-free plugin (blacklist mode)
    },
    "nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NIM_API_KEY}",
        "timeout": 900000,
        "chunkTimeout": 120000,
        "headerTimeout": 120000
      }
      // Models auto-managed by opencode-auto-free plugin (inject mode, default options/variants)
      // See ~/.config/opencode/auto-free/config.json
    },
    "kilo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kilo (200 req/hr per IP)",
      "options": {
        "baseURL": "https://api.kilo.ai/api/gateway/v1",
        "timeout": 900000,
        "chunkTimeout": 120000
      },
      "models": {}
      // Models auto-managed by opencode-auto-free plugin (blacklist mode)
      // See ~/.config/opencode/auto-free/config.json
      // The hand-pinned z-ai/glm-5.2:free entry was removed 2026-09-28: kilo
      // retired the :free variant (now 404), and the surviving z-ai/glm-5.2 is
      // paid ($1.40/$4.40 per M) — so no free GLM remains on kilo. It is in
      // auto-free's kilo `hide` list so it can never be auto-re-added.
    },
    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai (Zhipu) - GLM free tier",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}",
        "timeout": 900000,
        "chunkTimeout": 120000
      }
      // Models auto-managed by opencode-auto-free plugin (blacklist mode)
      // See ~/.config/opencode/auto-free/config.json
    },
    "opencode": {
      // Free-model list auto-managed by the opencode-auto-free plugin.
      // Keep/hide curated in ~/.config/opencode/auto-free/config.json
    }
  },
  // Title/summary auxiliary model: nemotron 3.5 lightning on kilo (fast, free).
  "small_model": "kilo/nvidia/nemotron-3.5-lightning:free",
  "enabled_providers": [
    "local",
    "openrouter",
    "nim",
    "opencode",
    "kilo",
    "zai"
  ],
  // Main model: OpenRouter Nemotron 3 Ultra (550B MoE) on the `high` reasoning
  // variant. Variant syntax is provider/model#variant; `high` sets
  // reasoning.effort = "high". This is the DEFAULT for inheriting agents
  // (build/plan/general/explore and the summary/compaction auxiliaries).
  // NOTE: per-agent `model` is honoured only for *custom* agents — the built-in
  // build/summary/compaction agents resolve their model internally and ignore
  // `agent.<name>.model`, so the top-level key is the only way to pin them.
  "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free#high",
  "agent": {
    // NOTE: the chat-only "glm52-free" agent was removed 2026-09-28 along
    // with its kilo/z-ai/glm-5.2:free pin — kilo retired that :free variant
    // (404) and the only surviving id is paid, so the agent could not work.
  },
"plugins": [
    "file://{env:HOME}/.config/opencode/plugins/token-optimizer-v2/index.ts",
    "file://{env:HOME}/.config/opencode/plugins/poorguy-ratelimit-v2/index.ts",
    "file://{env:HOME}/.config/opencode/plugins/auto-free-v2/index.ts",
    "file://{env:HOME}/.config/opencode/plugins/sentinel-v2/index.ts",
    "file://{env:HOME}/.config/opencode/plugins/subtask2-v2/index.ts",
    "file://{env:HOME}/.config/opencode/plugins/handoff-v2/index.ts"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "date": "allow",
      "which *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "find *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git branch *": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "git push*": "ask",
      "git pull*": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "kill *": "ask",
      "sudo *": "ask",
      "curl *": "allow",
      "wget *": "allow",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "npm *": "ask"
    }
  },
  "tool_output": {
    "max_lines": 5000,
    "max_bytes": 200000
  },
  "mcp": {
    // "playwright": {
    //   "type": "local",
    //   "command": [
    //     "npx",
    //     "-y",
    //     "@playwright/mcp@0.0.79",
    //     "--isolated",
    //     "--browser",
    //     "chromium"
    //   ],
    //   "enabled": true
    // },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.0.3"
      ],
      "enabled": true
    },
    "lemma": {
      "type": "local",
      "command": [
        "node",
        "{env:HOME}/.config/opencode/node_modules/lemma-mcp/dist/index.js"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2026.7.4"
      ],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-sqlite@1.0.9"
      ],
      "enabled": true
    },
    // searxng DISABLED 2026-09-28. opencode v2 has a NATIVE websearch tool
    // (opencode.tool.websearch) that works with no API key - it defaults to
    // Tinyfish and was verified live ("Web Search via Tinyfish" -> real
    // results). Native `webfetch` also replaces searxng's web_url_read.
    // Providers: exa, firecrawl, parallel, tavily, tinyfish. Set
    // "websearch": { "provider": "..." } to pin a specific one.
    // Only capability lost: searxng_search_suggestions (autocomplete), which a
    // model does not need - it writes full queries.
    // "searxng": {
    //   "type": "local",
    //   "command": ["npx", "-y", "mcp-searxng@1.16.0"],
    //   "enabled": false,
    //   "environment": { "SEARXNG_URL": "http://localhost:8080" }
    // },
    "obsidian-rest": {
      "type": "remote",
      "url": "https://127.0.0.1:27124/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:OBSIDIAN_API_KEY}"
      }
    }
    // "postman": {
    //   "type": "remote",
    //   "url": "https://mcp.eu.postman.com/code",
    //   "enabled": true,
    //   "headers": {
    //     "Authorization": "Bearer {env:POSTMAN_API_KEY}"
    //   }
    // }
  }
}
