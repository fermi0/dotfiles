  "small_model": "nvidia/nemotron-3-nano-30b-a3b",
  "enabled_providers": [
    "local",
    "openrouter",
    "nim",
    "opencode"
  ],
  "plugin": [
 [
  "file:///home/work/.config/opencode/plugins/opencode-token-optimizer/dist/server.js",
  {
   "tokenOptimization": {
    "rtk": {
     "enabled": true
    },
    "dedup": {
     "enabled": true,
     "maxEntries": 200,
     "ttlMs": 600000
    },
    "readCompact": {
     "enabled": true,
     "collapseRepeatedLines": true,
     "trimTrailingWs": true
    },
    "wrap": {
     "enabled": true,
     "maxLineWidth": 120
    },
    "history": {
     "enabled": false,
     "keepLastTurns": 32
    },
    "systemPrompt": {
     "enabled": true,
     "codeModeNudge": "\n\n[Token-Optimizer hint] For batched tool work (>=3 tool calls, filter/aggregate/transform of results, or large file processing), prefer the `execute` tool (Code Mode). It can call multiple tools in one round, process data locally, and only return the summary to the context."
    }
   }
  }
 ],
 "file:///home/work/.config/opencode/plugins/opencode-token-optimizer/dist/tui.js",
  "@thd3178/opencode-poorguy-ratelimit",
  "@bdliyq/opencode-rate-limit-retry",
  "opencode-swarm-plugin/plugin",
 "opencode-throughput",
 "opencode-bash-guard",
 "opencode-scheduler",
 "opencode-sentinel",
 "opencode-ops",
 "@openspoon/subtask2",
 "opencode-todo-progress",
 "@fleetingecho/opencode-handoff"
],
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "date": "allow",
      "which *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "find *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git branch *": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "git push*": "ask",
      "git pull*": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "kill *": "ask",
      "sudo *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "npm *": "ask"
    }
  },
  "tool_output": {
    "max_lines": 5000,
    "max_bytes": 200000
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.79",
        "--isolated",
        "--browser",
        "chromium"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.0.3"
      ],
      "enabled": true
    },
    "lemma": {
      "type": "local",
      "command": [
        "node",
        "/home/work/.config/opencode/node_modules/lemma-mcp/dist/index.js"
      ],
      "enabled": true
    },
    "with-context": {
      "type": "local",
      "command": [
        "node",
        "/home/work/apps/wcm-local/node_modules/with-context-mcp/dist/index.js"
      ],
      "enabled": true,
      "environment": {
        "OBSIDIAN_API_URL": "{env:OBSIDIAN_API_URL}",
        "OBSIDIAN_API_KEY": "{env:OBSIDIAN_API_KEY}",
        "OBSIDIAN_VAULT": "/home/shared/Zurnel",
        "PROJECT_BASE_PATH": "/home/shared/Zurnel"
      }
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "/home/work"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "fetch-mcp@0.0.5"
      ],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "git-mcp@1.0.0"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2026.7.4"
      ],
      "enabled": true
    },
    "time": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "time-mcp@1.0.6"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.7.0",
        "--slim"
      ],
      "enabled": false
    },
    "sqlite": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-sqlite@1.0.9",
        "/home/work/data/business.db"
      ],
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-searxng@1.16.0"
      ],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://localhost:8080"
      }
    },
    "filesystem-zurnel": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "/home/shared/Zurnel"
      ],
      "enabled": true
    },
    "obsidian-rest": {
      "type": "remote",
      "url": "https://127.0.0.1:27124/mcp/",
