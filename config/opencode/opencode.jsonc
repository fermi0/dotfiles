{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama-server (raw llama.cpp)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "timeout": 900000,
        "chunkTimeout": 120000,
        "top_p": 0.95
      },
      "models": {
        "Ornith-1.5-35B-A3B-APEX-Quality": {
          "name": "Ornith-1.5-35B-A3B APEX - agentic RL-tuned MoE, (KV q8_0)",
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "stream": true,
          "options": {
            "temperature": 0.6
          },
          "variants": {
            "precise": {
              "temperature": 0.2,
              "top_p": 0.9,
              "min_p": 0.05
            },
            "balanced": {
              "temperature": 0.6,
              "top_p": 0.95,
              "min_p": 0.1
            },
            "creative": {
              "temperature": 0.8,
              "top_p": 0.95
            },
            "benchmark": {
              "temperature": 1.0,
              "top_p": 0.99,
              "min_p": 0.1
            }
          }
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Open Router",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 900000,
        "chunkTimeout": 120000,
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.2": {
          "name": "GLM-5.2 (Z.ai paid) - $0.97/$3.04 per 1M tok, ~$0.0001/call",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "stream": true,
          "reasoning": true,
          "options": {
            "temperature": 1.0,
            "top_p": 0.95
          },
          "variants": {
            "reasoning": {
              "reasoningEffort": "high"
            },
            "balanced": {
              "reasoningEffort": "medium"
            },
            "concise": {
              "reasoningEffort": "low"
            }
          }
        }
      }
      // Other models auto-managed by opencode-auto-free plugin (blacklist mode)
    },
    "nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NIM_API_KEY}",
        "timeout": 900000,
        "chunkTimeout": 120000,
        "headerTimeout": 120000
      }
      // Models auto-managed by opencode-auto-free plugin (inject mode, default options/variants)
      // See ~/.config/opencode/auto-free/config.json
    },
    "kilo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kilo (200 req/hr per IP)",
      "options": {
        "baseURL": "https://api.kilo.ai/api/gateway/v1",
        "timeout": 900000,
        "chunkTimeout": 120000
      },
      "models": {
        "z-ai/glm-5.2:free": {
          "name": "Z.ai: GLM 5.2 (free, no tools)",
          "limit": {
            "context": 32768,
            "output": 29491
          },
          "stream": true,
          "reasoning": true,
          "tool_call": false
        }
      }
      // Models auto-managed by opencode-auto-free plugin (blacklist mode)
      // See ~/.config/opencode/auto-free/config.json
      // NOTE: z-ai/glm-5.2:free explicitly defined above (tool_call:false)
      // because the free endpoint has no tool-use support. Preserved by
      // auto-free (defined models are always kept in blacklist mode).
    },
    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai (Zhipu) - GLM free tier",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}",
        "timeout": 900000,
        "chunkTimeout": 120000
      }
      // Models auto-managed by opencode-auto-free plugin (blacklist mode)
      // See ~/.config/opencode/auto-free/config.json
    },
    "opencode": {
      // Free-model list auto-managed by the opencode-auto-free plugin.
      // Keep/hide curated in ~/.config/opencode/auto-free/config.json
    }
  },
  "small_model": "kilo/nvidia/nemotron-3-super-120b-a12b:free",
  "enabled_providers": [
    "local",
    "openrouter",
    "nim",
    "opencode",
    "kilo",
    "zai"
  ],
  "agent": {
    "glm52-free": {
      "description": "Chat-only agent pinned to Kilo GLM 5.2 free (endpoint has no tool-use support)",
      "mode": "primary",
      "model": "kilo/z-ai/glm-5.2:free",
      "permission": {
        "bash": "deny"
      },
      // Legacy tools map is the ONLY client-side switch that actually strips
      // tool definitions from the outgoing request (tool_call:false and
      // permission:deny still send them in opencode 1.18.x). Scoped to this
      // agent only — build/plan/general are untouched.
      "tools": {
        "*": false,
        "bash": false,
        "read": false,
        "write": false,
        "edit": false,
        "glob": false,
        "grep": false,
        "list": false,
        "task": false,
        "todowrite": false,
        "webfetch": false,
        "websearch": false,
        "skill": false,
        "question": false,
        "lsp": false
      }
    }
  },
  "plugin": [
    [
      "file://{env:HOME}/.config/opencode/plugins/opencode-token-optimizer/dist/server.js",
      {
        "tokenOptimization": {
          "rtk": {
            "enabled": true
          },
          "dedup": {
            "enabled": true,
            "maxEntries": 200,
            "ttlMs": 600000
          },
          "readCompact": {
            "enabled": true,
            "collapseRepeatedLines": true,
            "trimTrailingWs": true
          },
          "wrap": {
            "enabled": true,
            "maxLineWidth": 120
          },
          "history": {
            "enabled": false,
            "keepLastTurns": 32
          },
          "systemPrompt": {
            "enabled": true,
            "codeModeNudge": "\n\n[Token-Optimizer hint] For batched tool work (>=3 tool calls, filter/aggregate/transform of results, or large file processing), prefer the `execute` tool (Code Mode). It can call multiple tools in one round, process data locally, and only return the summary to the context."
          }
        }
      }
    ],
    "file://{env:HOME}/.config/opencode/plugins/opencode-token-optimizer/dist/tui.js",
    "file://{env:HOME}/.config/opencode/plugins/opencode-poorguy-ratelimit",
    "file://{env:HOME}/.config/opencode/plugins/opencode-auto-free",
    "opencode-scheduler",
    "opencode-sentinel",
    "@openspoon/subtask2",
    "@fleetingecho/opencode-handoff"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "date": "allow",
      "which *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "find *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git branch *": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "git push*": "ask",
      "git pull*": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "kill *": "ask",
      "sudo *": "ask",
      "curl *": "allow",
      "wget *": "allow",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "npm *": "ask"
    }
  },
  "tool_output": {
    "max_lines": 5000,
    "max_bytes": 200000
  },
  "mcp": {
    // "playwright": {
    //   "type": "local",
    //   "command": [
    //     "npx",
    //     "-y",
    //     "@playwright/mcp@0.0.79",
    //     "--isolated",
    //     "--browser",
    //     "chromium"
    //   ],
    //   "enabled": true
    // },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.0.3"
      ],
      "enabled": true
    },
    "lemma": {
      "type": "local",
      "command": [
        "node",
        "{env:HOME}/.config/opencode/node_modules/lemma-mcp/dist/index.js"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2026.7.4"
      ],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-sqlite@1.0.9"
      ],
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-searxng@1.16.0"
      ],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://localhost:8080"
      }
    },
    "obsidian-rest": {
      "type": "remote",
      "url": "https://127.0.0.1:27124/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:OBSIDIAN_API_KEY}"
      }
    },
    // "postman": {
    //   "type": "remote",
    //   "url": "https://mcp.eu.postman.com/code",
    //   "enabled": true,
    //   "headers": {
    //     "Authorization": "Bearer {env:POSTMAN_API_KEY}"
    //   }
    // }
  }
}
