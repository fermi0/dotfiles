    "nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NIM_API_KEY}",
        "timeout": 900000,
        "chunkTimeout": 120000
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B (NIM) - Flagship",
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "stream": true,
          "reasoning": true,
          "options": {
            "temperature": 1.0,
            "top_p": 0.95
          },
          "variants": {
            "reasoning": {
              "reasoningEffort": "high"
            },
            "balanced": {
