[Unit]
Description=OpenSCQ30 watchdog — apply Soundcore settings on every Bluetooth connect
Documentation=file://%h/.local/bin/openscq30-watchdog.sh
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/openscq30-watchdog.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
