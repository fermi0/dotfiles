[Unit]
Description=SearXNG local meta-search (127.0.0.1:8080)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/searxng
Environment=SEARXNG_SETTINGS_PATH=%h/apps/searxng/searxng-settings.yml
ExecStart=%h/apps/searxng/.venv/bin/python -m searx.webapp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
