[Unit]
Description=OpenCode Job: nepal-daily-news-scan

[Service]
Type=oneshot
WorkingDirectory=%h
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
ExecStart="/usr/bin/perl" "%h/.config/opencode/scheduler/supervisor.pl" "%h/.config/opencode/scheduler/scopes/work-aee1aaee713c/jobs/nepal-daily-news-scan.json"
StandardOutput=append:%h/.config/opencode/logs/scheduler/work-aee1aaee713c/nepal-daily-news-scan.log
StandardError=append:%h/.config/opencode/logs/scheduler/work-aee1aaee713c/nepal-daily-news-scan.log

[Install]
WantedBy=default.target
