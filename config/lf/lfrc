# =========================
# KDE Connect
# =========================
cmd kdeconnect ${{
    clear; tput cup $(( $(tput lines)/3 )); tput bold
    set -f
    printf "%s\n" "$fx"

    kde_devs=$(kdeconnect-cli --list-available 2>/dev/null | grep "(paired and reachable)" | awk -F: '{print $1}' | sed 's/- //')
    [[ -n "$kde_devs" ]] || { echo "No devices found"; exit 1; }

    echo "Available devices:"
    echo "$kde_devs" | nl
    vared -p "Select device number: " -c dev_num
    device=$(echo "$kde_devs" | sed -n "${dev_num}p")
    [[ -n "$device" ]] || { echo "Invalid selection"; exit 1; }

    sanitize_filename() {
        local filename="$1"
        local base="$(basename -- "$filename")"
        local s="$(echo "$base" | sed 's/[^a-zA-Z0-9 ._-]/_/g' | tr -s ' ')"
        s="$(echo "$s" | sed 's/^_*//;s/_*$//;s/__*/_/g')"
        echo "$s"
    }

    send_files() {
        for i in "$@"; do
            if [[ -d "$i" ]]; then
                find "$i" -type f -size +1c -exec kdeconnect-cli --share {} --name "$device" 2>/dev/null \;
            elif [[ -f "$i" ]]; then
                [[ $(stat -c%s -- "$i") -gt 1 ]] && kdeconnect-cli --share "$i" --name "$device" 2>/dev/null
            fi
        done
    }

    for i in $fx; do
        if [[ -d "$i" ]]; then
            find "$i" -type f | while read -r file; do
                pathname="$(dirname -- "$file")"
                s="$(sanitize_filename "$file")"
                new_path="$pathname/$s"
                if [[ "$file" != "$new_path" ]]; then
                    mv -- "$file" "$new_path" 2>/dev/null || new_path="$file"
                fi
                send_files "$new_path"
            done
        elif [[ -f "$i" ]]; then
            pathname="$(dirname -- "$i")"
            s="$(sanitize_filename "$i")"
            new_path="$pathname/$s"
            if [[ "$i" != "$new_path" ]]; then
                mv -- "$i" "$new_path" 2>/dev/null || new_path="$i"
            fi
            send_files "$new_path"
        fi
    done

    printf "Press any key to exit!"
    read -n 1
}}

# =========================
# ADB (safer indexing)
# =========================
cmd adb ${{
    clear; tput cup $(( $(tput lines)/3 )); tput bold
    printf "%s\n" $fx

    adb_devices=$(adb devices | awk 'NR>1 && $2=="device" {print $1}')
    [[ -n "$adb_devices" ]] || { echo "No devices found"; exit 1; }

    adb_devices_array=(${=adb_devices})
    echo "Available devices:"
    echo "$adb_devices" | nl
    vared -p "Select device number: " -c dev_id

    if ! [[ "$dev_id" =~ ^[0-9]+$ ]] || ((dev_id < 1 || dev_id > ${#adb_devices_array[@]})); then
        echo "Invalid selection"
        exit 1
    fi

    device="${adb_devices_array[$dev_id]}"
    echo "Selected device: $device"

    vared -p "Specify destination (relative under /sdcard/Download): " -c dest
    [[ -z "$dest" ]] && dest=""

    for i in $fx; do
        if [[ -e "$i" && -s "$i" ]]; then
            s="$(basename -- "$i" | sed 's/[^a-zA-Z0-9 .,_-]/ /g' | tr -s ' ')"
            s="$(echo "$s" | sed 's/^_*//;s/_*$//;s/__*/_/g')"
            adb -s "$device" push -- "$i" "/sdcard/Download/$dest/$s"
        else
            echo "File $i missing/empty, skipping."
        fi
    done

    printf "Press any key to exit!"
    read -n 1
}}

# =========================
# Rsync to home dir
# =========================
cmd rsync ${{
    clear
    tput cup $(( $(tput lines) / 3 ))
    tput bold
    
    # Handle filenames with spaces properly
    set -f
    IFS="$(printf '\n\t')"
    
    printf "Selected files:\n%s\n\n" "$fx"
    
    vared -p "Destination path (relative to \$HOME): " -c dest
    
    [ -z "$dest" ] && dest="."
    dest_full="$HOME/$dest"
    
    if [ ! -d "$dest_full" ]; then
        printf "Creating directory: %s\n" "$dest_full"
        mkdir -p -- "$dest_full" || {
            printf "Error: Failed to create destination\n"
            read -k 1
            exit 1
        }
    fi
    
    vared -p "Remote host (empty for local): " -c remote_host
    
    printf "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "IMPORTANT: Trailing slash behavior\n"
    printf "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "WITH slash    (folder/):  Copies CONTENTS into destination\n"
    printf "WITHOUT slash (folder):   Copies FOLDER itself into destination\n"
    printf "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n"
    
    if [ -n "$remote_host" ]; then
        printf "[*] Starting remote rsync to %s:%s\n\n" "$remote_host" "$dest_full"
        
        # Remote transfer - use compression and explicit ssh
        rsync -auzh -e ssh --progress \
            --no-perms --no-owner --no-group \
            $fx "$remote_host:$dest_full/"
        
        rsync_status=$?
        
        if [ $rsync_status -eq 0 ]; then
            printf "\n[+] Transfer complete\n"
            
            remote_user="${remote_host%%@*}"
            [ "$remote_user" = "$remote_host" ] && remote_user="$USER"
            
            printf "[*] Changing ownership to %s on remote...\n" "$remote_user"
            ssh "$remote_host" "chown -R '$remote_user:$remote_user' '$dest_full'" && {
                printf "[+] Ownership updated\n"
            } || {
                printf "[!] Warning: Ownership change failed\n"
            }
        else
            printf "\n[!] Rsync failed (exit code: %d)\n" "$rsync_status"
        fi
    else
        # Local transfer - validate y/n input
        while true; do
            vared -p "Transfer to different user account? (y/n): " -c yn
            case $yn in
                [Yy] )
                    vared -p "Enter target username: " -c target_user
                    
                    if ! id "$target_user" &>/dev/null; then
                        printf "[!] Error: User '%s' does not exist\n" "$target_user"
                        read -k 1
                        exit 1
                    fi
                    
                    target_home=$(eval echo ~"$target_user")
                    dest_full="$target_home/$dest"
                    
                    printf "\n[*] Starting local rsync to %s (user: %s)\n\n" "$dest_full" "$target_user"
                    
                    if [ ! -d "$dest_full" ]; then
                        sudo mkdir -p -- "$dest_full" || {
                            printf "Error: Failed to create destination\n"
                            read -k 1
                            exit 1
                        }
                    fi
                    
                    # Local cross-user with full flags
                    sudo rsync -ausxhP $fx "$dest_full/"
                    rsync_status=$?
                    
                    if [ $rsync_status -eq 0 ]; then
                        printf "\n[+] Transfer complete\n"
                        printf "[*] Changing ownership to %s...\n" "$target_user"
                        
                        sudo chown -R "$target_user:$target_user" "$dest_full" && {
                            printf "[+] Ownership updated\n"
                        } || {
                            printf "[!] Warning: Ownership change failed\n"
                        }
                    else
                        printf "\n[!] Rsync failed (exit code: %d)\n" "$rsync_status"
                    fi
                    break
                    ;;
                [Nn] )
                    # Local same-user transfer
                    printf "\n[*] Starting local rsync to %s\n\n" "$dest_full"
                    
                    rsync -ausxhP $fx "$dest_full/"
                    rsync_status=$?
                    
                    if [ $rsync_status -eq 0 ]; then
                        printf "\n[+] Transfer complete\n"
                    else
                        printf "\n[!] Rsync failed (exit code: %d)\n" "$rsync_status"
                    fi
                    break
                    ;;
                * )
                    printf "Invalid input. Please enter 'y' or 'n'\n"
                    ;;
            esac
        done
    fi
    
    printf "\n"
    read -k 1
}}

