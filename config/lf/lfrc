cmd sudochmod ${{
    clear; tput cup $(( $(tput lines)/3 )); tput bold
    set -f
    printf "%s\n" $fx
    vared -p "Mode Bits: " -c ans
    sudo chmod -Rv -- "$ans" $fx
    lf -remote "send $id reload"
}}

cmd chmod ${{
    clear; tput cup $(( $(tput lines)/3 )); tput bold
    set -f
    printf "%s\n" $fx

    first="$(echo "$fx" | head -n1)"
    if [[ -d "$first" ]]; then
        vared -p "Mode Bits[Dirs]: " -c dir_mode
        vared -p "Mode Bits[Files]: " -c file_mode
        for path in $fx; do
            [[ -n "${dir_mode:-}" ]] && find "$path" -type d -exec chmod -v -- "$dir_mode" {} +
            [[ -n "${file_mode:-}" ]] && find "$path" -type f -exec chmod -v -- "$file_mode" {} +
        done
    elif [[ -f "$first" ]]; then
        vared -p "Mode Bits[Files]: " -c file_mode
        for path in $fx; do
            chmod -v -- "$file_mode" "$path"
        done
    else
        echo "Invalid selection"
        exit 1
    fi

    lf -remote "send $id reload"
}}

cmd chown ${{
    clear; tput cup $(( $(tput lines)/3 )); tput bold
    set -f
    printf "%s\n" $fx
    vared -p "owner:group (or ~ for user:user, / for root:root): " -c ans

    if [[ "$ans" == "~" ]]; then
        sudo chown -Rv $(whoami):$(whoami) $fx
    elif [[ "$ans" == "/" ]]; then
        sudo chown -Rv root:root $fx
    elif [[ "$ans" == *":"* ]]; then
        sudo chown -Rv -- "$ans" $fx
    else
        sudo chown -Rv -- "$ans:$ans" $fx
    fi

    lf -remote "send $id reload"
}}

