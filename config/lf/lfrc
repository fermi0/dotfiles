# =========================
# Helpers (terminal / editor)
# =========================
# We intentionally don't "set" these, we just use env vars with fallbacks.
# Terminal launchers differ; we support common ones via a small chooser.

cmd term-open ${{
    # usage: :term-open <command...>
    # Opens a new terminal window and runs the given command.
    # Respects $TERMINAL if it supports -e; otherwise tries common terminals.
    set -f
    if [[ -n "${TERMINAL:-}" ]]; then
        # Most terminals support: $TERMINAL -e <cmd...>
        "$TERMINAL" -e "$@" & disown
        exit 0
    fi

    # fallback list (edit to your preference)
    for t in foot alacritty kitty wezterm konsole gnome-terminal xterm; do
        if command -v "$t" >/dev/null 2>&1; then
            case "$t" in
                gnome-terminal) gnome-terminal -- "$@" & disown;;
                konsole)        konsole -e "$@" & disown;;
                wezterm)        wezterm start -- "$@" & disown;;
                foot)           foot -e "$@" & disown;;
                *)              "$t" -e "$@" & disown;;
            esac
            exit 0
        fi
    done

    echo "No terminal found. Set \$TERMINAL or install one (foot/alacritty/kitty/wezterm/...)."
}}

