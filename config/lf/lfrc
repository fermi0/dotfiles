cmd mkfile ${{
    # creates and opens files in nvim
    for p in "$@"; do
        mkdir -p -- "$(dirname -- "$p")" 2>/dev/null || true
        : > "$p"
    done
    lf -remote "send $id :term-open nvim \"$1\""
}}

cmd sudo-mkfile ${{
    for p in "$@"; do
        sudo mkdir -p -- "$(dirname -- "$p")" 2>/dev/null || true
        sudo sh -c ": > \"$p\""
    done
    lf -remote "send $id :term-open sudo -E nvim \"$1\""
}}

