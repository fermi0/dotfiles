# =========================
# Pager (no tmux)
# =========================
cmd pager ${{
    # open file in a new terminal with bat (fallback to less)
    if command -v bat >/dev/null 2>&1; then
        lf -remote "send $id :term-open sh -lc 'bat --paging=always -- \"$f\"'"
    elif command -v less >/dev/null 2>&1; then
        lf -remote "send $id :term-open sh -lc 'less -R -- \"$f\"'"
    else
        lf -remote "send $id :term-open sh -lc 'cat -- \"$f\"; echo; read -n 1'"
    fi
}}

