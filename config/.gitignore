# .gitignore for the config/ directory
# This .gitignore lives at config/.gitignore, so all paths below are
# relative to the config/ directory.

# ── opencode plugin internals (rebuildable via `npm install` in each plugin) ──
opencode/node_modules/
opencode/package-lock.json
opencode/bun.lock
opencode/.gitignore
opencode/package.json
opencode/local.jsonc
opencode-local/node_modules/
opencode-local/package-lock.json
opencode-local/bun.lock
opencode-local/.gitignore
opencode-local/package.json
opencode-local-xdg/

# ── opencode local backups and runtime artifacts ──
opencode/opencode.jsonc.backup*
opencode/opencode.jsonc.latest-stable-*
opencode/--db-path
opencode/*.log
opencode/backups/
opencode/logs/
opencode/jobs/
opencode/rate-limit-retry.json
opencode/rate-limit-retry-debug.log
opencode/plugin-meta.json
opencode/opencode-poorguy-ratelimit.log
# contains API keys (chmod 600) - never commit
opencode/opencode-poorguy-ratelimit.jsonc
opencode/opencode-mem.jsonc      # dead plugin (auto-capture disabled)
opencode/.DS_Store
opencode/opencode.db*            # local sqlite (in shared/data/ via symlink in stage 4)

# ── opencode plugin subdirs (each has its own node_modules) ──
opencode/plugins/opencode-token-optimizer/node_modules/
opencode/plugins/opencode-token-optimizer/--db-path
opencode/plugins/opencode-token-optimizer/dist/
opencode/plugins/opencode-token-optimizer/package-lock.json
opencode/plugins/opencode-poorguy-ratelimit/dist/
opencode/plugins/opencode-poorguy-ratelimit/package-lock.json
opencode/plugins/backups/
opencode/plugin/subtask2/logs/

# ── sqlite runtime data (DBs live in shared/data/ or are dead) ──
swarm-tools/swarm.db*
swarm-tools/sessions/
swarm-tools/logs/

# ── nvim plugin state (managed by lazy.nvim, not hand-edited) ──
nvim/.git
nvim/.gitignore
nvim/lazy-lock.json.bak
nvim/.luarc.json
nvim/lua/**/lazy.lua  # the lazy plugin manager itself, if present

# ── hypr backup files (regenerated by Hyprland scripts and JaKooLit) ──
hypr/*.backup.*
hypr/animations.backup.*
hypr/backups/
hypr/wallpaper_effects/.wallpaper_*
hypr/.initial_startup_done
hypr/Monitor_Profiles/*.bak
hypr/configs/*.bak.*
hypr/configs/*~

# ── rofi runtime state (current wallpaper, etc.) ──
rofi/.current_wallpaper
rofi/.cache/

# ── opencode-mem, lemma, etc. runtime data ──
# (the configs themselves are tracked, but the runtime data is in shared/data/)
# No specific paths here; just noting that the live DBs are NOT in ~/.config/

# ── browser app data (NOT config) ──
chromium/
google-chrome-for-testing/
google-chrome-for-testing-headless/

# ── Obsidian browser cache (the real obsidian config is in the vault) ──
obsidian/Cache/
obsidian/Code Cache/
obsidian/Cookies*
obsidian/Crashpad/
obsidian/DawnGraphiteCache/
obsidian/DawnWebGPUCache/
obsidian/blob_storage/
obsidian/SharedStorage/
obsidian/TransportSecurity/
obsidian/Trust Tokens*
obsidian/WebStorage/
obsidian/DIPS/
obsidian/Dictionaries/
obsidian/.org.chromium.*
obsidian/SingletonLock
obsidian/SingletonSocket
obsidian/SingletonCookie

# ── KDE / Qt / GTK auto-mutating state (NOT config) ──
dconf/
gtk-3.0/bookmarks
gtk-4.0/
QtProject.conf
QtProject/
mimeapps.list.bak
recently-used.xbel
kdeconnect.appstaterc

# ── application-specific auto-mutating data (NOT config) ──
# (most of these are mentioned in the survey's "do NOT version-control" list)
discord/
spotify/
Postman/
LM Studio/
Cursor/
Antigravity/
DBeaver/
Kvantum/
enchant/
procps/
pulse/
qalculate/
qBittorrent/
swappy/
Webcamoid/
ctpv/
cherrytree/
ffuf/
go/
mpv/
normcap/
nwg-displays/
nwg-look/
pavucontrol.ini
qt5ct/
qt6ct/
yay/
zsh-backup/
chromium-flags.conf
Teams*/  # Teams-for-linux
ZapZap/  # WhatsApp client
chatterino*/  # if present

# ── xdg autostart backup ──
autostart/*.desktop.bak

# ── general junk ──
*.bak
*.backup
*.tmp
*~
.DS_Store
Thumbs.db
