#!/usr/bin/env bash
# yz-float — run a command in a compact auto-centered floating kitty window (Hyprland).
# Usage: yz-float [WIDTHxHEIGHT] <command...>
# Non-interactive zsh (-c) on purpose: no rc noise, deterministic behavior.
set -euo pipefail
SIZE=""; if [[ "${1:-}" =~ ^[0-9]+x[0-9]+$ ]]; then SIZE="$1"; shift; fi
W="${SIZE%x*}"; H="${SIZE#*x}"; W="${W:-1000}"; H="${H:-380}"
command -v hyprctl >/dev/null || { echo "yz-float: hyprctl missing" >&2; exit 127; }
CLS="yzfloat-$$-$(date +%s)"
kitty --class "$CLS" --title yzfloat -e zsh -c "$*" >/dev/null 2>&1 &
pid=$!
addr=""
for _ in $(seq 1 60); do
  addr=$(hyprctl -j clients 2>/dev/null | jq -r --arg c "$CLS" \
        '[.[]|select(.class==$c)][-1].address // empty')
  [[ -n "$addr" ]] && break; sleep 0.05
done
if [[ -n "$addr" ]]; then
  # 0.56+: legacy `hyprctl dispatch <args>` is dead - hyprctl dispatch is now
  # Lua-only, so focuswindow/resizewindowpixel/movewindowpixel all died with a
  # parse error. window.resize with x/y sets an EXACT size (not a delta).
  hyprctl eval "hl.dispatch(hl.dsp.focus({window=\"address:$addr\"}))" >/dev/null 2>&1 || true
  hyprctl eval "hl.dispatch(hl.dsp.window.resize({window=\"address:$addr\", x=$W, y=$H}))" >/dev/null 2>&1 || true
  # top-center placement
  monw=$(hyprctl -j monitors 2>/dev/null | jq -r '(.[] | select(.focused==true) | .width) // (.[0].width) // 1920')
  x=$(( (monw - W) / 2 )); (( x < 0 )) && x=0
  hyprctl eval "hl.dispatch(hl.dsp.window.move({window=\"address:$addr\", x=$x, y=40}))" >/dev/null 2>&1 || true
fi
wait "$pid" 2>/dev/null || true
exit 0
