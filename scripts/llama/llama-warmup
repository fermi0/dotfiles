#!/bin/zsh
# Wait for llama-server /health, restore the saved KV prefix (system prompt) if present,
# then send one tiny completion to prime CUDA graphs / sampler paths.
for i in {1..240}; do
  [[ "$(curl -s http://127.0.0.1:1234/health 2>/dev/null)" == '{"status":"ok"}' ]] && break
  sleep 1
done

# Prime CUDA graphs / sampler paths first (this clobbers slot 0, so do it BEFORE restore).
curl -s http://127.0.0.1:1234/v1/chat/completions -H 'Content-Type: application/json' \
  -d '{"messages":[{"role":"user","content":"hi"}],"max_tokens":1,"temperature":0}' > /dev/null 2>&1

# Restore saved slot KV (system-prompt prefix) -> first real prompt skips most of prefill.
# Must run AFTER the prime request, which would otherwise overwrite the slot.
# Fails silently if no snapshot exists yet (first boot after this change).
curl -s -X POST "http://127.0.0.1:1234/slots/0?action=restore" \
  -H 'Content-Type: application/json' \
  -d '{"filename":"ornith-prefix.bin"}' > /dev/null 2>&1
echo "llama-server warm"
